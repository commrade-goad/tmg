<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TMG htmx Todo</title>
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/htmx.min.js" defer></script>
</head>
<body>
  <main class="app">
    <header>
      <p class="eyebrow">TMG + htmx</p>
      <h1>Todo</h1>
      <p class="hint">Session-only list. Refreshing keeps it; a new cookie starts empty.</p>
    </header>

    <form class="add"
          hx-post="/todos"
          hx-target="#todo-list"
          hx-swap="innerHTML"
          hx-on::after-request="if (event.detail.successful) this.reset()">
      <input name="title" maxlength="200" required autocomplete="off"
             placeholder="What needs doing?">
      <button type="submit">Add</button>
    </form>

    <div id="todo-list" hx-get="/todos" hx-trigger="load" hx-swap="innerHTML">
      <p class="empty">Loading...</p>
    </div>
  </main>
</body>
</html>
